# A public hub: serves feeds and the dashboard and accepts pushes from agents behind NAT.
# Run humansout-hub-verifier.service next to it so its dashboard shows real verdicts. Put TLS in
# front of it (reverse proxy or tunnel) and set public_url, accept_push and trusted_creators first.
[Unit]
Description=HumansOut public hub
After=network-online.target docker.service

[Service]
Environment=HUMANSOUT_HOME=/var/lib/humansout/hub
ExecStart=/usr/local/bin/humansout serve --host 127.0.0.1 --port 7400
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
